{
  // The Worker and its Durable Object. Runtime types come from `npm run server:types`
  // (wrangler types → worker-configuration.d.ts). Shared code is imported from ../src/lib.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
