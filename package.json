{
  "name": "trio-game",
  "private": true,
  "version": "0.1.0",
  "description": "Trio: a phone-first, 2-player online card game of spotting trios. Static site plus a small Cloudflare room server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json && npm run server:check",
    "test": "node --test \"src/**/*.test.ts\" \"server/test/*.test.ts\"",
    "symbols": "node scripts/gen-symbols.ts",
    "icons": "node scripts/build-icons.ts",
    "server:dev": "wrangler dev -c server/wrangler.jsonc",
    "server:deploy": "wrangler deploy -c server/wrangler.jsonc",
    "server:types": "wrangler types -c server/wrangler.jsonc --strict-vars=false server/worker-configuration.d.ts",
    "server:check": "wrangler types -c server/wrangler.jsonc --strict-vars=false --check server/worker-configuration.d.ts && tsc -p server/tsconfig.json"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.2",
    "opentype.js": "^2.0.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "trystero": "^0.27.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cylfox/trio-game.git"
  },
  "homepage": "https://trio.cylfox.com/",
  "funding": "https://ko-fi.com/cylfox"
}
